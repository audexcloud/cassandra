{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm -w run typecheck:libs && pnpm --filter @workspace/cassandra run build",
  "outputDirectory": "artifacts/cassandra/dist/public",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
